<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>KITSUNE EQ @VERSION@</title>
    <organization>com.prodbyperke</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <background file="background.png" alignment="bottomleft" scaling="proportional"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plugin" description="Installs to /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.prodbyperke.kitsuneeq.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plugin" description="Installs to /Library/Audio/Plug-Ins/Components (Logic, GarageBand)">
        <pkg-ref id="com.prodbyperke.kitsuneeq.au"/>
    </choice>
    <pkg-ref id="com.prodbyperke.kitsuneeq.vst3" version="@VERSION@">KitsuneEQ-VST3.pkg</pkg-ref>
    <pkg-ref id="com.prodbyperke.kitsuneeq.au" version="@VERSION@">KitsuneEQ-AU.pkg</pkg-ref>
</installer-gui-script>
